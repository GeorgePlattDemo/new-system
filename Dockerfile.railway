# Separate candidate System. The old GitHub Pages demo and Store runtime are untouched.
# Only the existing System application is built; Store lives in its own service.
FROM node:22.23.2-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV NITRO_PRESET=node-server
RUN npm run typecheck && npm run build && test -f .output/server/index.mjs

FROM node:22.23.2-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
COPY --from=build /app/.output ./.output
EXPOSE 8080
CMD ["node", ".output/server/index.mjs"]
