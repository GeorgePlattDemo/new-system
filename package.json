{
  "name": "scan-to-build-system",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/system/system.test.ts src/system/playhouse-admission.test.ts src/system/store-client.test.ts && STORE_ZERO_ROOT=${STORE_ZERO_ROOT:-/tmp/store-zero-main} node --experimental-strip-types --test src/system/store/published-wire.test.ts src/system/store/http.integration.test.ts src/system/start-own-bench.test.ts",
    "test:system": "node --experimental-strip-types --test src/system/system.test.ts && STORE_ZERO_ROOT=${STORE_ZERO_ROOT:-/tmp/store-zero-main} node --experimental-strip-types --test src/system/store/http.integration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
